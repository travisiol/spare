# Copy to .env.local. Every value is optional for the local demo.
# Nothing here is a public (NEXT_PUBLIC_) variable: all of it stays on the server.

# --- Database -----------------------------------------------------------------
# PostgreSQL connection string. Unset = embedded Postgres (PGlite) in ./data/pg,
# which is for local use only and can be opened by one process at a time.
# DATABASE_URL=postgres://spare:password@localhost:5432/spare
# Allow the embedded database when NODE_ENV=production (single-instance demos only).
# SPARE_ALLOW_EMBEDDED_DB=1

# --- Site ---------------------------------------------------------------------
# The public host, without scheme. Required in production: wallet sign-in
# messages must be issued for exactly this domain.
# SPARE_APP_DOMAIN=spare.example
# Set to 0 to remove the demo from a deployment.
# SPARE_DEMO_ENABLED=1

# --- Network ------------------------------------------------------------------
# Robinhood Chain RPC (used to verify smart-contract wallet signatures).
# SPARE_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# --- Admin --------------------------------------------------------------------
# Comma-separated wallet addresses allowed into /admin after signing in.
# ADMIN_WALLETS=0x0000000000000000000000000000000000000000
# Operator token for /admin (16+ characters). Generate one: openssl rand -hex 24
# ADMIN_TOKEN=

# --- Background work ----------------------------------------------------------
# 0 = do not run the worker inside the web process (use `npm run worker` or a cron).
# SPARE_INLINE_WORKER=1
# Bearer secret for POST /api/internal/tick (16+ characters).
# CRON_SECRET=

# --- Live providers -----------------------------------------------------------
# HMAC secret for POST /api/webhooks/transactions/webhook. Setting it makes the
# live transaction-data adapter report "available". See docs/PROVIDERS.md.
# SPARE_TXN_WEBHOOK_SECRET=

# --- Policy -------------------------------------------------------------------
# SPARE fee in basis points of the round-up total (default 0).
# SPARE_FEE_BPS=0
# Smallest batch that can be invested, in cents (default 100).
# SPARE_MIN_ORDER_CENTS=100
# Hours a closed week waits for approval before it expires (default 144).
# SPARE_APPROVAL_WINDOW_HOURS=144
