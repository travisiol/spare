{
  "name": "spare",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3658",
    "build": "next build",
    "start": "next start -p 3658",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --disable-warning=ExperimentalWarning --test \"tests/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
